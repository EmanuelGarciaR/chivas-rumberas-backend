# ─────────────────────────────────────────────
# Base de datos (Neon PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15&pool_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&connect_timeout=15"

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET="cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres"
JWT_EXPIRES_IN="8h"

# ─────────────────────────────────────────────
# Email (Resend) — https://resend.com
# ─────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# En desarrollo usa: onboarding@resend.dev (sin verificar dominio)
RESEND_FROM_EMAIL="onboarding@resend.dev"
ADMIN_EMAIL="admin@tudominio.com"

# ─────────────────────────────────────────────
# WhatsApp (Twilio) — https://twilio.com
# Deja vacío para desactivar el canal de WhatsApp
# # ─────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
# En producción coloca el origen exacto del frontend.
# Para varios orígenes, sepáralos por coma:
# CORS_ORIGINS=https://frontend.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# Cloudinary (Subida directa firmada de imágenes)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# ─────────────────────────────────────────────
# Google Calendar (Cuenta de Servicio)
# ─────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL="tu-cuenta-servicio@tu-proyecto.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="tu-calendario@group.calendar.google.com"
