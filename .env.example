# ─────────────────────────────────────────────
# Base de datos (Neon PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET="cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres"
JWT_EXPIRES_IN="8h"

# ─────────────────────────────────────────────
# Email (Resend) — https://resend.com
# ─────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# En desarrollo usa: onboarding@resend.dev (sin verificar dominio)
RESEND_FROM_EMAIL="onboarding@resend.dev"
ADMIN_EMAIL="admin@tudominio.com"

# ─────────────────────────────────────────────
# WhatsApp (Twilio) — https://twilio.com
# Deja vacío para desactivar el canal de WhatsApp
# # ─────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
# En producción coloca el origen exacto del frontend.
# Para varios orígenes, sepáralos por coma:
# CORS_ORIGIN=https://frontend.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:3000
